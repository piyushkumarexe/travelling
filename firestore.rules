rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validCoords(lat, lng) {
      return lat is number && lat >= -90 && lat <= 90
        && lng is number && lng >= -180 && lng <= 180;
    }

    function optionalString(data, field, max) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    function requiredString(data, field, max) {
      return field in data && data[field] is string
        && data[field].size() > 0 && data[field].size() <= max;
    }

    function validLocation(location) {
      return location is map
        && location.keys().hasOnly(['lat', 'lng', 'accuracy'])
        && validCoords(location.lat, location.lng)
        && (!('accuracy' in location) || location.accuracy == null
          || (location.accuracy is number
            && location.accuracy >= 0 && location.accuracy <= 50000));
    }

    // Account/role records. Owners cannot change role, createdAt, or grant
    // themselves administrative privileges. Backend Admin SDK bypasses rules.
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['role', 'createdAt'])
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt is timestamp
        && optionalString(request.resource.data, 'displayName', 120)
        && optionalString(request.resource.data, 'email', 320);
      allow update: if isAdmin() || (isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Profiles are private. Focused contact/vehicle upserts remain supported,
    // including repair of a missing profile on first run.
    match /profiles/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'photoUrl', 'photoPath', 'language',
          'emergencyContactName', 'emergencyContactPhone', 'interests',
          'budget', 'travelStyle', 'vehicle', 'createdAt', 'updatedAt',
          'travelDocumentsV1', 'journeyOperationsV1'
        ])
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && optionalString(request.resource.data, 'name', 120)
        && optionalString(request.resource.data, 'photoUrl', 2048)
        && optionalString(request.resource.data, 'photoPath', 1024)
        && optionalString(request.resource.data, 'language', 20)
        && optionalString(request.resource.data, 'emergencyContactName', 120)
        && optionalString(request.resource.data, 'emergencyContactPhone', 40)
        && optionalString(request.resource.data, 'budget', 30)
        && optionalString(request.resource.data, 'travelStyle', 30)
        && optionalString(request.resource.data, 'vehicle', 30)
        && (!('interests' in request.resource.data)
          || (request.resource.data.interests is list
            && request.resource.data.interests.size() <= 30))
        && (!('travelDocumentsV1' in request.resource.data)
          || request.resource.data.travelDocumentsV1 is list)
        && (!('journeyOperationsV1' in request.resource.data)
          || request.resource.data.journeyOperationsV1 is list);
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /safetyZones/{zoneId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Incident coordinates match Incident.toMap(): location.lat/location.lng.
    match /incidents/{incidentId} {
      allow get: if isSelf(resource.data.uid) || isAdmin();
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'reporterName', 'description', 'category', 'severity',
          'status', 'location', 'summary', 'recommendedAction', 'photoUrl',
          'videoUrl', 'photoPath', 'videoPath', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'reported'
        && request.resource.data.severity in ['low', 'medium', 'high', 'critical']
        && request.resource.data.category in [
          'theft', 'fraud', 'assault', 'harassment', 'accident',
          'unsafe_area', 'poor_infrastructure', 'natural_hazard', 'other'
        ]
        && 'location' in request.resource.data
        && validLocation(request.resource.data.location)
        && requiredString(request.resource.data, 'description', 2000)
        && request.resource.data.description.size() >= 10
        && requiredString(request.resource.data, 'reporterName', 120)
        && optionalString(request.resource.data, 'summary', 500)
        && optionalString(request.resource.data, 'recommendedAction', 500)
        && optionalString(request.resource.data, 'photoUrl', 2048)
        && optionalString(request.resource.data, 'videoUrl', 2048)
        && optionalString(request.resource.data, 'photoPath', 1024)
        && optionalString(request.resource.data, 'videoPath', 1024)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    match /emergencyEvents/{eventId} {
      allow get: if isSelf(resource.data.uid) || isAdmin();
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'status', 'kind', 'reason', 'location', 'createdAt'
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.kind in ['sos', 'power_off', 'live_share']
        && requiredString(request.resource.data, 'name', 120)
        && optionalString(request.resource.data, 'reason', 300)
        && validLocation(request.resource.data.location)
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin() || (isSelf(resource.data.uid)
        && resource.data.status == 'active'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['active', 'cancelled', 'resolved']
        && validLocation(request.resource.data.location)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'location', 'updatedAt', 'lastLocationAt', 'resolvedAt'
        ]));
      allow delete: if isAdmin();
    }

    function validPublicId(data, token) {
      return data.keys().hasOnly(['token', 'recordId', 'ownerName', 'status', 'updatedAt'])
        && data.keys().hasAll(['token', 'recordId', 'ownerName', 'status', 'updatedAt'])
        && data.token == token
        && token.matches('^[0-9a-f]{64}$')
        && requiredString(data, 'recordId', 128)
        && requiredString(data, 'ownerName', 80)
        && data.status in ['active', 'revoked']
        && data.updatedAt is timestamp;
    }

    function validPrivateId(data) {
      return data.keys().hasOnly([
          'uid', 'ownerName', 'token', 'status', 'createdAt', 'updatedAt',
          'photoUrl', 'photoPath', 'emergencyContactName', 'emergencyContactPhone'
        ])
        && requiredString(data, 'ownerName', 80)
        && data.token is string && data.token.matches('^[0-9a-f]{64}$')
        && data.status in ['active', 'revoked']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && optionalString(data, 'photoUrl', 2048)
        && optionalString(data, 'photoPath', 1024)
        && optionalString(data, 'emergencyContactName', 120)
        && optionalString(data, 'emergencyContactPhone', 40);
    }

    // A private ID and its minimal public verification record are written in
    // one batch. getAfter ensures revocation cannot leave a stale active token.
    match /digitalIds/{id} {
      allow get: if isSelf(resource.data.uid) || isAdmin();
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && validPrivateId(request.resource.data)
        && getAfter(/databases/$(database)/documents/digitalIdPublic/$(request.resource.data.token)).data.recordId == id
        && getAfter(/databases/$(database)/documents/digitalIdPublic/$(request.resource.data.token)).data.token == request.resource.data.token
        && getAfter(/databases/$(database)/documents/digitalIdPublic/$(request.resource.data.token)).data.ownerName == request.resource.data.ownerName
        && getAfter(/databases/$(database)/documents/digitalIdPublic/$(request.resource.data.token)).data.status == 'active';
      allow update: if isAdmin() || (isSelf(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.token == resource.data.token
        && request.resource.data.createdAt == resource.data.createdAt
        && validPrivateId(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerName', 'status', 'updatedAt', 'photoUrl', 'photoPath',
          'emergencyContactName', 'emergencyContactPhone'
        ])
        && getAfter(/databases/$(database)/documents/digitalIdPublic/$(resource.data.token)).data.recordId == id
        && getAfter(/databases/$(database)/documents/digitalIdPublic/$(resource.data.token)).data.ownerName == request.resource.data.ownerName
        && getAfter(/databases/$(database)/documents/digitalIdPublic/$(resource.data.token)).data.status == request.resource.data.status);
      allow delete: if isAdmin() || (isSelf(resource.data.uid)
        && !existsAfter(/databases/$(database)/documents/digitalIdPublic/$(resource.data.token)));
    }

    // Unauthenticated single-token verification is intentional for rescuers.
    // Only name/status/timestamps are public; contacts, UID and photos never are.
    match /digitalIdPublic/{token} {
      allow get: if validPublicId(resource.data, token);
      allow list: if false;
      allow create, update: if signedIn()
        && validPublicId(request.resource.data, token)
        && getAfter(/databases/$(database)/documents/digitalIds/$(request.resource.data.recordId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/digitalIds/$(request.resource.data.recordId)).data.token == token
        && getAfter(/databases/$(database)/documents/digitalIds/$(request.resource.data.recordId)).data.ownerName == request.resource.data.ownerName
        && getAfter(/databases/$(database)/documents/digitalIds/$(request.resource.data.recordId)).data.status == request.resource.data.status;
      allow delete: if signedIn()
        && validPublicId(resource.data, token)
        && get(/databases/$(database)/documents/digitalIds/$(resource.data.recordId)).data.uid == request.auth.uid;
    }

    match /users/{uid}/itineraries/{itineraryId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'destination', 'days', 'interests', 'budget', 'travelStyle',
          'plan', 'createdAt', 'updatedAt'
        ])
        && requiredString(request.resource.data, 'destination', 120)
        && request.resource.data.destination.size() >= 2
        && request.resource.data.days is int
        && request.resource.data.days >= 1 && request.resource.data.days <= 10
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 10
        && request.resource.data.budget in ['budget', 'mid', 'luxury']
        && request.resource.data.travelStyle in ['relaxed', 'balanced', 'packed']
        && request.resource.data.plan is list
        && request.resource.data.plan.size() >= 1
        && request.resource.data.plan.size() <= 10
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSelf(uid);
    }

    match /ecoScores/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'score', 'byMode', 'badges', 'sessions', 'updatedAt'])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.byMode is map
        && request.resource.data.badges is list
        && request.resource.data.badges.size() <= 30
        && request.resource.data.sessions is number
        && request.resource.data.sessions >= 0
        && request.resource.data.updatedAt is string;
      allow delete: if isSelf(uid) || isAdmin();

      match /activities/{activityId} {
        allow get, list: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly([
            'uid', 'mode', 'distanceMeters', 'durationSeconds', 'note', 'createdAt'
          ])
          && request.resource.data.mode in ['walk', 'cycle', 'transit']
          && request.resource.data.distanceMeters is number
          && request.resource.data.distanceMeters > 0
          && request.resource.data.distanceMeters <= 2000000
          && request.resource.data.durationSeconds is number
          && request.resource.data.durationSeconds >= 0
          && optionalString(request.resource.data, 'note', 300);
        allow update, delete: if false;
      }
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'title', 'body', 'type', 'read', 'payload', 'createdAt'
        ])
        && requiredString(request.resource.data, 'title', 160)
        && requiredString(request.resource.data, 'body', 600)
        && requiredString(request.resource.data, 'type', 40)
        && request.resource.data.read is bool
        && request.resource.data.payload is map
        && request.resource.data.createdAt is timestamp;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/expenses/{expenseId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.userId == uid
        && request.resource.data.id == expenseId
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'tripId', 'amount', 'currency', 'category',
          'merchant', 'expenseDate', 'paymentMethod', 'notes', 'receiptUrl',
          'receiptPath', 'latitude', 'longitude', 'locationName', 'splits',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && requiredString(request.resource.data, 'currency', 8)
        && request.resource.data.currency.size() >= 3
        && request.resource.data.category in [
          'food', 'transport', 'stay', 'tickets', 'shopping', 'fuel',
          'activities', 'medical', 'emergency', 'other'
        ]
        && optionalString(request.resource.data, 'merchant', 200)
        && request.resource.data.expenseDate is number
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && optionalString(request.resource.data, 'tripId', 128)
        && optionalString(request.resource.data, 'paymentMethod', 30)
        && optionalString(request.resource.data, 'notes', 2000)
        && optionalString(request.resource.data, 'receiptUrl', 2048)
        && optionalString(request.resource.data, 'receiptPath', 1024)
        && optionalString(request.resource.data, 'locationName', 200)
        && request.resource.data.splits is list
        && request.resource.data.splits.size() <= 50
        && (resource == null || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/expenseData/{docId} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid) && docId == 'budget'
        && request.resource.data.keys().hasOnly(['daily', 'perTrip', 'currency', 'updatedAt'])
        && (!('daily' in request.resource.data) || request.resource.data.daily == null
          || (request.resource.data.daily is number
            && request.resource.data.daily > 0
            && request.resource.data.daily <= 10000000))
        && (!('perTrip' in request.resource.data) || request.resource.data.perTrip is map)
        && requiredString(request.resource.data, 'currency', 8)
        && request.resource.data.updatedAt is number;
    }

    match /users/{uid}/bookingRefs/{bookingId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.userId == uid
        && request.resource.data.bookingId == bookingId
        && request.resource.data.keys().hasOnly([
          'bookingId', 'userId', 'tripId', 'category', 'provider',
          'serviceType', 'origin', 'destination', 'bookingDate', 'status',
          'externalReference', 'notes', 'createdAt', 'updatedAt'
        ])
        && requiredString(request.resource.data, 'provider', 60)
        && request.resource.data.category in [
          'ride', 'flight', 'train', 'bus', 'hotel', 'carRental', 'activities'
        ]
        && request.resource.data.status in ['saved', 'confirmed', 'cancelled']
        && optionalString(request.resource.data, 'tripId', 128)
        && optionalString(request.resource.data, 'serviceType', 60)
        && optionalString(request.resource.data, 'origin', 200)
        && optionalString(request.resource.data, 'destination', 200)
        && optionalString(request.resource.data, 'bookingDate', 20)
        && optionalString(request.resource.data, 'externalReference', 100)
        && optionalString(request.resource.data, 'notes', 2000)
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && (resource == null || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/travelDocuments/{documentId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.userId == uid
        && request.resource.data.documentId == documentId
        && request.resource.data.keys().hasOnly([
          'documentId', 'userId', 'tripId', 'type', 'title', 'documentNumber',
          'issuer', 'issueDate', 'expiryDate', 'travelDate', 'startDate', 'endDate',
          'departureLocation', 'arrivalLocation', 'notes', 'fileUrl', 'storagePath',
          'fileName', 'fileSize', 'uploadStatus', 'pnr', 'bookingRef', 'airline',
          'flightNumber', 'departureAirport', 'arrivalAirport', 'terminal', 'seat',
          'departureDateTime', 'arrivalDateTime', 'hotelName', 'checkInDateTime',
          'checkOutDateTime', 'address', 'contact', 'operatorName', 'providerName',
          'venue', 'location', 'eventDateTime', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.type in [
          'passport', 'visa', 'idProof', 'flightTicket', 'trainTicket',
          'busTicket', 'hotelBooking', 'cabRental', 'activityTicket',
          'travelInsurance', 'other'
        ]
        && requiredString(request.resource.data, 'title', 120)
        && request.resource.data.uploadStatus in ['none', 'uploading', 'uploaded', 'uploadFailed']
        && optionalString(request.resource.data, 'tripId', 128)
        && optionalString(request.resource.data, 'notes', 2000)
        && optionalString(request.resource.data, 'fileUrl', 2048)
        && optionalString(request.resource.data, 'storagePath', 1024)
        && optionalString(request.resource.data, 'fileName', 255)
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && (resource == null || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/journeyOperations/{operationId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.userId == uid
        && request.resource.data.id == operationId
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'kind', 'title', 'detail', 'extra', 'completed',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.kind in [
          'medicine', 'luggage', 'taskBoard', 'contacts', 'connectivity',
          'dietary', 'accessibility', 'souvenirs', 'journal', 'checkpoints',
          'homeReadiness', 'localKnowledge', 'visaTracker', 'travelInsurance',
          'bookingConfirmations', 'flightBoarding', 'trainCoach', 'busBoarding',
          'hotelStay', 'rentalInspection', 'parkingLocator', 'tollsPermits',
          'fuelStops', 'restBreaks', 'meetingPoints', 'groupRoster', 'childTravel',
          'seniorCare', 'petTravel', 'laundryPlan', 'waterRefills',
          'deviceCharging', 'workationSetup', 'localEvents', 'weatherBackup',
          'medicalFacilities', 'lostAndFound'
        ]
        && requiredString(request.resource.data, 'title', 160)
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 2000
        && request.resource.data.extra is string
        && request.resource.data.extra.size() <= 500
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && (resource == null || (request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.kind == resource.data.kind));
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/savedPlaces/{savedId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'placeId', 'place', 'createdAt', 'updatedAt'])
        && requiredString(request.resource.data, 'placeId', 500)
        && request.resource.data.place is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (resource == null || (request.resource.data.uid == resource.data.uid
          && request.resource.data.placeId == resource.data.placeId
          && request.resource.data.createdAt == resource.data.createdAt));
      allow delete: if isSelf(uid);
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // Deny every unlisted/current-and-future collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
