# YatraWise — backend configuration reference
#
# These values are NOT used from a file by the app or by GitHub Actions.
# The Cloud Functions read them from the Firebase project environment:
#
#   Firebase console → Functions → Functions environment configuration
#   or:  firebase functions:env:set --token NVIDIA_API_KEY "nvapi-..."
#
# NEVER commit real values to this repository. Never put them in the
# Flutter app. The Android app only needs a Firebase configuration
# (firebase_options.dart) and the Google Maps Android meta-data key
# (a separate, server-allowlisted key) in android/AndroidManifest.xml.

# --- NVIDIA AI (tourism assistant, itinerary generator, incident triage) ---
NVIDIA_API_KEY=nvapi_your_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Google Gemini (easiest free option — Google account, no card) ---
# One secret is enough: the app talks to Gemini's OpenAI-compatible endpoint.
# Free key: https://aistudio.google.com/apikey
#   flutter build apk --dart-define=GEMINI_API_KEY=AIza...
#   (CI secret: GEMINI_API_KEY, optional GEMINI_MODEL)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Generic OpenAI-compatible AI fallback (used when NO NVIDIA/Gemini key) ---
# Any provider exposing /chat/completions: Groq, OpenRouter, Hack Club AI,
# Mistral, Together, ... Only used when the Cloud Functions backend is down.
# Build the app with these dart-defines (or add them as GitHub secrets):
#   AI_API_KEY, AI_BASE_URL, AI_MODEL
AI_API_KEY=your_generic_ai_key_here
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=meta-llama/llama-3.1-8b-instruct

# --- MapTiler tiles (client-side key, safe to ship in the APK) ---
# Default already compiled in; override at build time if needed:
#   flutter build apk --dart-define=MAPTILER_API_KEY=...
MAPTILER_API_KEY=udi5P84vPD7vdzptwwAN

# --- OpenWeather (current + forecast, proxied by the backend) ---
OPENWEATHER_API_KEY=your_openweather_key_here

# --- Google Maps / Places / Directions (proxied by the backend) ---
# This key must be restricted to the Cloud Functions IP (all
# cloud.google.com APIs, or the Functions service) and to the legacy
# Places API, Places API (New) if used, Geocoding API and Routes API.
GOOGLE_MAPS_API_KEY=your_google_maps_server_key_here

# --- Region for Cloud Functions (default us-central1) ---
GOOGLE_FUNCTION_REGION=us-central1

# --- Android manifest (client-side, separate key) ---
# android/AndroidManifest.xml → meta-data name="com.google.android.geo.API_KEY"
# Use a client-restricted key (Android app package + SHA-1 of the
# debug/release signing certs). The release build in CI is signed with
# the project's debug keystore until you provide your own.
