# Tourism configuration reference — placeholders only.
#
# Do not source this file into a Flutter build. Private provider credentials
# are resolved by Cloud Functions from Firebase Secret Manager at runtime.
# CI intentionally never passes them through --dart-define.
#
# Configure real values with an approved administrator workflow, for example:
#   npx firebase-tools functions:secrets:set NVIDIA_API_KEY --project PROJECT_ID
# Never commit real values, shell history, tokens, or downloaded keystores.

# Backend-only AI (lib/ai.js has a safe default model/base URL).
NVIDIA_API_KEY=replace_through_firebase_secret_manager
# NVIDIA_MODEL=optional_backend_model_override
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Backend-only weather and Google Places/Geocoding/Routes integrations.
OPENWEATHER_API_KEY=replace_through_firebase_secret_manager
GOOGLE_MAPS_API_KEY=replace_through_firebase_secret_manager

# Client map tiles. This value is embedded in the APK and therefore is NOT a
# private secret. Restrict it by API/origin where supported and set quotas.
# flutter build apk --dart-define=MAPTILER_API_KEY=restricted_client_value
MAPTILER_API_KEY=restricted_client_value

# Android Maps SDK manifest placeholder. Supply through the environment or a
# protected CI secret; restrict by application ID app.roamio.tourism + SHA-1.
# Do not hardcode it in AndroidManifest.xml.
# MAPS_ANDROID_API_KEY=android_restricted_client_value

# Google Sign-In's web client ID is an identifier, not a provider credential.
# GOOGLE_WEB_CLIENT_ID=your_oauth_web_client_id

# Release signing is documented in android/RELEASE_SIGNING.md. No signing
# passwords belong in this file or in Git.
