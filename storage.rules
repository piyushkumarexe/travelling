rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|quicktime|webm|3gpp)');
    }

    // New app versions keep authenticated Storage paths in Firestore and read
    // through the SDK. Existing download tokens cannot be revoked by rules;
    // rotate them in Firebase console during the documented migration.
    match /incidents/{uid}/{fileName} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && ((isImage() && request.resource.size <= 10485760)
          || (isVideo() && request.resource.size <= 52428800));
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Avatars are private account data, not readable by every signed-in user.
    match /avatars/{uid}/{fileName} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && isImage() && request.resource.size <= 5242880;
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /receipts/{uid}/{fileName} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && isImage() && request.resource.size <= 5242880;
      allow delete: if isSelf(uid);
    }

    function isVaultDocument() {
      return isImage() || request.resource.contentType == 'application/pdf';
    }

    match /users/{uid}/travelDocuments/{documentId}/file {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && isVaultDocument() && request.resource.size <= 10485760;
      allow delete: if isSelf(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
