rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validCoords(lat, lng) {
      return lat is number && lat >= -90 && lat <= 90
        && lng is number && lng >= -180 && lng <= 180;
    }

    // ---- Account (role gate; clients can only create role 'user') ----
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasAll(['role'])
        && request.resource.data.keys().hasAtMost(['role', 'displayName', 'email', 'createdAt']);
      allow update: if (isSelf(uid)
        && resource.data.role == request.resource.data.role)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Profiles (private per user) ----
    match /profiles/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ---- Safety zones: any signed-in traveler can read; only admins write ----
    match /safetyZones/{zoneId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- Incidents: reporter reads their own; admins read/manage all ----
    match /incidents/{incidentId} {
      allow get: if isSelf(resource.data.uid) || isAdmin();
      // The app's "My reports" screen runs a `where('uid', == me)` LIST query.
      // With `list: if isAdmin()` only, that query was rejected outright and
      // every normal traveller's history stayed empty, so a reporter is
      // allowed to list exactly their own documents (rules evaluate the
      // per-document predicate, and the query is constrained by uid).
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      // The client stores the coordinates nested (location.lat / location.lng)
      // — see Incident.toMap(). Validating top-level `lat`/`lng` made this
      // rule reference a non-existent field, which is an EVALUATION ERROR, and
      // Firestore denies on error: no incident could ever be reported.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'reported'
        && request.resource.data.severity in ['low', 'medium', 'high', 'critical']
        && request.resource.data.category in [
          'theft', 'fraud', 'assault', 'harassment', 'accident',
          'unsafe_area', 'poor_infrastructure', 'natural_hazard', 'other'
        ]
        && 'location' in request.resource.data
        && request.resource.data.location is map
        && validCoords(request.resource.data.location.lat,
                       request.resource.data.location.lng)
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() <= 120;

      // Admins may change any field (status workflow); nobody else.
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    // ---- SOS emergency events: self + admins ----
    match /emergencyEvents/{eventId} {
      allow get: if isSelf(resource.data.uid) || isAdmin();
      // Same reason as /incidents: the Safety screen lists the traveller's own
      // SOS events with `where('uid', == me)`, which admin-only `list` denied.
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && validCoords(request.resource.data.location.lat,
                       request.resource.data.location.lng)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;

      // Owners may cancel/resolve their own active SOS; while an event is
      // active the owner may also refresh its live location fields (live
      // location sharing). Field changes other than the whitelisted live
      // keys are still rejected; admins may manage everything.
      allow update: if (
        (isSelf(resource.data.uid)
          && resource.data.status == 'active'
          && request.resource.data.uid == resource.data.uid
          && (
            request.resource.data.status in ['cancelled', 'resolved']
            || (
              request.resource.data.status == resource.data.status
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'kind', 'reason', 'location', 'updatedAt', 'lastLocationAt'])
            )
          )
        )
        || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- Digital emergency IDs ----
    // The private record (owner + admin only). Previously `get, list: if
    // signedIn()` let ANY signed-in user enumerate every traveller's name,
    // emergency contact phone and verification token — the token is the whole
    // secret of the QR, so that was a privacy hole, not a feature.
    match /digitalIds/{id} {
      allow get: if isSelf(resource.data.uid) || isAdmin();
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.token is string
        && request.resource.data.token.matches(r'^[0-9a-f]{64}$')
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80;

      // Owners may revoke/reactivate; admins may manage everything.
      allow update: if (isSelf(resource.data.uid)
        && request.resource.data.status in ['active', 'revoked']
        && request.resource.data.uid == resource.data.uid)
        || isAdmin();
      allow delete: if isSelf(resource.data.uid) || isAdmin();
    }

    // Public half of a Digital Emergency ID — what a rescuer who physically
    // has the QR code is allowed to see. The document id IS the 64-char token,
    // so `get` works for anyone who scanned the code while `list` stays
    // denied: the collection cannot be enumerated or harvested.
    // A revoked id is still readable (its status field says 'revoked'), which
    // is exactly how the verify screen reports a revoked ID.
    match /digitalIdPublic/{token} {
      allow get: if signedIn()
        && token.matches(r'^[0-9a-f]{64}$')
        && resource.data.token == token;
      // No list/query on purpose: tokens cannot be harvested in bulk.
      allow list: if false;

      allow create, update, delete: if signedIn()
        && request.resource.data.token == token
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['token', 'uid', 'ownerName', 'status', 'photoUrl',
              'emergencyContactName', 'emergencyContactPhone', 'updatedAt']);
    }

    // ---- Itineraries: per-user subcollection (rules-safe ownership) ----
    match /users/{uid}/itineraries/{itineraryId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.destination is string
        && request.resource.data.destination.size() >= 2
        && request.resource.data.destination.size() <= 120
        && request.resource.data.days is number
        && request.resource.data.days >= 1
        && request.resource.data.days <= 10
        && request.resource.data.budget in ['budget', 'mid', 'luxury']
        && request.resource.data.travelStyle in ['relaxed', 'balanced', 'packed']
        && request.resource.data.plan is list;
      allow update, delete: if isSelf(uid);
    }

    // ---- Eco score (document per uid) + activities subcollection ----
    match /ecoScores/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid;
      allow delete: if isSelf(uid) || isAdmin();

      match /activities/{activityId} {
        allow get, list: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.mode in ['walk', 'cycle', 'transit']
          && request.resource.data.distanceMeters is number
          && request.resource.data.distanceMeters > 0
          && request.resource.data.distanceMeters <= 2000000;
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // ---- Notifications live in the per-user subcollection ----
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 600;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSelf(uid);
    }

    // ---- Travel Expense Guard: strictly owner-only expense records ----
    // Nested under users/{uid} like itineraries; the authenticated UID must
    // match {uid} and the document's own userId field must match too, so a
    // user can never create/read/modify another user's expenses.
    match /users/{uid}/expenses/{expenseId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == expenseId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.currency is string
        && request.resource.data.currency.size() >= 3
        && request.resource.data.currency.size() <= 8
        && request.resource.data.category in [
          'food', 'transport', 'stay', 'tickets', 'shopping', 'fuel',
          'activities', 'medical', 'emergency', 'other'
        ]
        && request.resource.data.merchant is string
        && request.resource.data.merchant.size() <= 200
        && request.resource.data.expenseDate is number
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
      allow update: if isSelf(uid)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000;
      allow delete: if isSelf(uid);
    }

    // Optional budget configuration (single doc per user).
    match /users/{uid}/expenseData/{docId} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid)
        && (!('daily' in request.resource.data)
            || request.resource.data.daily == null
            || (request.resource.data.daily is number
                && request.resource.data.daily > 0
                && request.resource.data.daily <= 10000000));
    }

    // ---- Travel Booking Hub: user-saved booking references ----
    // Only metadata the user enters manually (provider, reference/PNR,
    // route text). Ownership strictly enforced; no credentials stored.
    match /users/{uid}/bookingRefs/{bookingId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.bookingId == bookingId
        && request.resource.data.provider is string
        && request.resource.data.provider.size() >= 1
        && request.resource.data.provider.size() <= 60
        && request.resource.data.category in ['ride','flight','train','bus','hotel','carRental','activities']
        && request.resource.data.status in ['saved','confirmed','cancelled']
        && (!('externalReference' in request.resource.data)
            || (request.resource.data.externalReference is string
                && request.resource.data.externalReference.size() <= 60));
      allow update: if isSelf(uid)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSelf(uid);
    }

    // ---- Travel Document & Booking Vault: private per user ----
    // Metadata only — files live in Storage (see storage.rules).
    match /users/{uid}/travelDocuments/{documentId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.documentId == documentId
        && request.resource.data.type in [
          'passport', 'visa', 'idProof', 'flightTicket', 'trainTicket',
          'busTicket', 'hotelBooking', 'cabRental', 'activityTicket',
          'travelInsurance', 'other'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.uploadStatus in ['none', 'uploaded', 'uploadFailed']
        && (!('tripId' in request.resource.data)
            || request.resource.data.tripId == null
            || request.resource.data.tripId is string)
        && (!('notes' in request.resource.data)
            || request.resource.data.notes == null
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 2000));
      allow update: if isSelf(uid)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.documentId == documentId;
      allow delete: if isSelf(uid);
    }

    // ---- Journey Operations: twelve private, Firebase-synced travel tools ----
    match /users/{uid}/journeyOperations/{operationId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == operationId
        && request.resource.data.kind in [
          'medicine', 'luggage', 'taskBoard', 'contacts', 'connectivity',
          'dietary', 'accessibility', 'souvenirs', 'journal', 'checkpoints',
          'homeReadiness', 'localKnowledge'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 160
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 2000
        && request.resource.data.extra is string
        && request.resource.data.extra.size() <= 500
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
      allow update: if isSelf(uid)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 160
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 2000
        && request.resource.data.extra is string
        && request.resource.data.extra.size() <= 500
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt is number;
      allow delete: if isSelf(uid);
    }

    // ---- Rate limits are backend-only ----
    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
